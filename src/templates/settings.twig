{% import '_includes/forms.twig' as forms %}

{{ forms.autosuggestField({
    label: 'Bypass token'|t('blitz'),
    instructions: 'The bypass token for your Vercel cache. '|t('blitz') ~ '<a href="https://vercel.com/docs/build-output-api/v3/features#on-demand-incremental-static-regeneration-isr" class="go" target="_blank" rel="noopener">'~ 'Learn more'|t('blitz') ~'</a>',
    suggestEnvVars: true,
    suggestions: craft.cp.getEnvSuggestions(),
    name: 'bypassToken',
    value: purger.bypassToken,
    errors: purger.getErrors('bypassToken'),
    required: true,
}) }}

{{ forms.textField({
    label: 'Concurrency'|t('blitz'),
    instructions: 'The number of concurrent requests to send when purging cache.'|t('blitz'),
    name: 'concurrency',
    value: purger.concurrency,
    errors: purger.getErrors('concurrency'),
    type: 'number',
    min: 1,
    max: 50,
}) }}

